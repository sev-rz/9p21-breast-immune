# Raw data: downloaded, never edited, recorded in metadata/ (commit what a person wrote,
# not what a program can download or rebuild)
data/raw/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/raw/README.md
!data/processed/README.md
!results/README.md
!data/processed/.gitkeep
!results/.gitkeep

# Python and OS files
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Pixi environments are rebuilt from pixi.lock, never committed
.pixi/*
!.pixi/config.toml

# Workflow state, saved images, generated report assets
.snakemake/
containers/*.tar.gz
containers/*.sif
report/

/.quarto/
**/*.quarto_ipynb

# Quarto
/.quarto/
reports/*.html
reports/*_files/
**/*.quarto_ipynb
